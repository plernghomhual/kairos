# CoinGecko (free tier, no key needed for basic endpoints)
COINGECKO_API_KEY=

# CryptoCompare News API (free tier)
CRYPTOCOMPARE_API_KEY=your_key_here

# Reddit API (create app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=kairos/0.1.0

# FRED (Federal Reserve Economic Data — free)
FRED_API_KEY=your_fred_key

# Local DB path
KAIROS_DB_PATH=kairos.db
