# CoinGecko (free tier, no key needed for basic endpoints)
COINGECKO_API_KEY=

# CryptoCompare News API (free tier)
CRYPTOCOMPARE_API_KEY=

# Reddit API (create app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=kairos/0.1.0

# FRED (Federal Reserve Economic Data — free)
FRED_API_KEY=

# CryptoPanic and market-data provider keys (optional)
CRYPTOPANIC_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Solana whale flow RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Local DB path
KAIROS_DB_PATH=kairos.db

# API security (required in production)
KAIROS_API_KEY=

# CORS origins (comma-separated, defaults to localhost-only)
KAIROS_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Alerting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
